# ==============================================================================
# NimbleVoice — Centralized Frontend Environment Variables Template
# Note: Do NOT add public TURN credential variables here; ICE servers are fetched
# dynamically from GET /api/v1/webrtc/ice-servers and held in memory only.
# ==============================================================================

# Next.js Application Client URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go Gin Backend REST API Base URL (Default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Go Socket.IO Real-Time Gateway Host (Default: http://localhost:8080)
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# Socket.IO Handshake Gateway Path (Default: /socket.io/)
NEXT_PUBLIC_SOCKET_PATH=/socket.io/

# Native WebSocket presence endpoint (Deprecated: scheduled for removal in Phase 3)
NEXT_PUBLIC_PRESENCE_WS_URL=ws://localhost:8080/ws/presence
